rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper checking verified owner Google email
    function isOwner() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'bengamers494@gmail.com';
    }

    // Role lookup using the named Firestore database ID from firebase-applet-config.json
    function isProductManager() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             firestore.get(/databases/ai-studio-sonachandigoldco-1d070b90-f752-41d1-88b9-2d74371a4161/documents/staff/$(request.auth.token.email)).data.role in ['owner', 'product_manager'];
    }

    // Authorizes verified owner, and evaluates product_manager lookup against named database
    function isAuthorizedUploader() {
      return isOwner() || isProductManager();
    }

    // Validation: Strictly under 2MB (2,097,152 bytes) and only image/jpeg, image/png, and image/webp (no SVG)
    function isValidProductImage() {
      return request.resource.size < 2 * 1024 * 1024 &&
             request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /products/{productId}/{fileName} {
      // Public read access for storefront visitors
      allow read: if true;
      // Creation restricted to authorized staff and strictly validated JPEG/PNG/WEBP images under 2MB
      allow create: if isAuthorizedUploader() && isValidProductImage();
      // Updates restricted to authorized staff and strictly validated JPEG/PNG/WEBP images under 2MB
      allow update: if isAuthorizedUploader() && isValidProductImage();
      // Deletions restricted to authorized staff
      allow delete: if isAuthorizedUploader();
    }
  }
}
