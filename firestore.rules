rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSuperOwner() {
      return isSignedIn() && request.auth.token.email == 'bengamers494@gmail.com';
    }

    function staffDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }

    function getStaffRole() {
      return isSuperOwner()
        ? 'owner'
        : (staffDocExists() ? get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role : 'none');
    }

    function isOwner() {
      return isSignedIn() && (isSuperOwner() || getStaffRole() == 'owner');
    }

    function isRateManager() {
      return isSignedIn() && (isOwner() || getStaffRole() == 'rate_manager');
    }

    function isProductManager() {
      return isSignedIn() && (isOwner() || getStaffRole() == 'product_manager');
    }

    function isSupport() {
      return isSignedIn() && (isOwner() || getStaffRole() == 'support');
    }

    function isViewer() {
      return isSignedIn() && (isOwner() || getStaffRole() == 'viewer');
    }

    function isStaff() {
      return isSignedIn() && (isOwner() || getStaffRole() != 'none');
    }

    function isEnquiryViewer() {
      return isSignedIn() && (isOwner() || getStaffRole() in ['owner', 'support', 'viewer']);
    }

    // Validation for Product documents
    function isValidProduct(data) {
      return data.sku is string && data.sku.size() > 0 && data.sku.size() <= 50 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             data.metal in ['gold', 'silver'] &&
             data.category is string && data.category.size() <= 50 &&
             data.weightG is number && data.weightG > 0 &&
             data.makingType in ['fixed', 'perGram'] &&
             data.makingValue is number && data.makingValue >= 0 &&
             data.stock is int && data.stock >= 0 &&
             data.status in ['draft', 'active', 'archived'] &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (data.metal != 'gold' || data.karat in [18, 21, 22, 24]);
    }

    // Check if any of the three bullion rate fields are modified in this write
    function rateFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['gold24kPerTola', 'silverRate', 'silverUnit']);
    }

    // Validation for Store Settings & Info
    // Rate fields are optional on create or info-only updates; if present, they must be numbers >= 0 and silverUnit must be 'tola' or 'gram'
    function isValidSettings(data) {
      return (!('gold24kPerTola' in data) || (data.gold24kPerTola is number && data.gold24kPerTola >= 0)) &&
             (!('silverRate' in data) || (data.silverRate is number && data.silverRate >= 0)) &&
             (!('silverUnit' in data) || data.silverUnit in ['tola', 'gram']);
    }

    // Strict validation when rate fields are being set or modified
    function hasValidRateFields(data) {
      return data.gold24kPerTola is number && data.gold24kPerTola >= 0 &&
             data.silverRate is number && data.silverRate >= 0 &&
             data.silverUnit in ['tola', 'gram'];
    }

    // Atomic Batch Audit Check for Bullion Rate Changes
    function hasValidRateAudit() {
      let goldId = request.resource.data.lastGoldHistoryId;
      let silverId = request.resource.data.lastSilverHistoryId;
      return goldId is string && silverId is string &&
        !exists(/databases/$(database)/documents/rateHistory/$(goldId)) &&
        existsAfter(/databases/$(database)/documents/rateHistory/$(goldId)) &&
        getAfter(/databases/$(database)/documents/rateHistory/$(goldId)).data.newValue == request.resource.data.gold24kPerTola &&
        getAfter(/databases/$(database)/documents/rateHistory/$(goldId)).data.metal == 'gold' &&
        getAfter(/databases/$(database)/documents/rateHistory/$(goldId)).data.changedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/rateHistory/$(goldId)).data.changedAt == request.time &&
        !exists(/databases/$(database)/documents/rateHistory/$(silverId)) &&
        existsAfter(/databases/$(database)/documents/rateHistory/$(silverId)) &&
        getAfter(/databases/$(database)/documents/rateHistory/$(silverId)).data.newValue == request.resource.data.silverRate &&
        getAfter(/databases/$(database)/documents/rateHistory/$(silverId)).data.metal == 'silver' &&
        getAfter(/databases/$(database)/documents/rateHistory/$(silverId)).data.changedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/rateHistory/$(silverId)).data.changedAt == request.time;
    }

    // Validation for Enquiries creation by public
    function isValidEnquiryCreate(data) {
      return data.keys().hasOnly(['customerName', 'customerPhone', 'fulfilment', 'status', 'notes', 'rateSnapshot', 'estimatedTotal', 'items', 'createdAt']) &&
             data.status == 'new' &&
             data.fulfilment in ['courier', 'pickup'] &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.estimatedTotal is number && data.estimatedTotal >= 0 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50;
    }

    // 1. PRODUCTS COLLECTION
    match /products/{productId} {
      allow get, list: if (resource.data.status == 'active') || isStaff();
      allow create: if isProductManager() && isValidProduct(request.resource.data);
      allow update: if isProductManager() && isValidProduct(request.resource.data);
      allow delete: if isOwner();
    }

    // 2. SETTINGS COLLECTION (settings/store)
    match /settings/{settingId} {
      allow get: if settingId == 'store';
      allow list: if isStaff();
      allow create: if isOwner() && isValidSettings(request.resource.data);
      allow update: if isValidSettings(request.resource.data) && (
                       // Rate change: when any of the 3 rate fields change, require atomic rate audit for both owner and rate_manager
                       (rateFieldsChanged() &&
                        hasValidRateFields(request.resource.data) &&
                        hasValidRateAudit() &&
                        (isOwner() || (isRateManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gold24kPerTola', 'silverRate', 'silverUnit', 'ratesUpdatedAt', 'lastHistoryId', 'lastGoldHistoryId', 'lastSilverHistoryId']))))
                       ||
                       // Info change: when none of the 3 rate fields change, owner may update info/policy fields freely without rate audit
                       (!rateFieldsChanged() && isOwner())
                     );
      allow delete: if false;
    }

    // 3. RATE HISTORY COLLECTION
    match /rateHistory/{historyId} {
      allow get, list: if isStaff();
      allow create: if isRateManager() &&
                       !exists(/databases/$(database)/documents/rateHistory/$(historyId)) &&
                       request.resource.data.metal in ['gold', 'silver'] &&
                       request.resource.data.newValue is number && request.resource.data.newValue >= 0 &&
                       request.resource.data.oldValue is number && request.resource.data.oldValue >= 0 &&
                       request.resource.data.unit in ['tola', 'gram'] &&
                       request.resource.data.changedBy == request.auth.uid &&
                       request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    // 4. ENQUIRIES COLLECTION
    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiryCreate(request.resource.data);
      allow get, list: if isEnquiryViewer();
      allow update: if isSupport() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
                       request.resource.data.status in ['new', 'contacted', 'awaiting_customer', 'confirmed', 'completed', 'cancelled'] &&
                       (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow delete: if isOwner();
    }

    // 5. STAFF COLLECTION
    match /staff/{email} {
      allow get: if isSignedIn() && (request.auth.token.email == email || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner() &&
                                       (request.resource == null || request.resource.data.role in ['owner', 'rate_manager', 'product_manager', 'support', 'viewer']);
    }
  }
}
